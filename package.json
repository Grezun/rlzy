{
  "name": "higgsfield-social-agent-xpera",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "reel": "tsx packages/engine/src/cli.ts",
    "studio": "npm run studio -w @reel/video",
    "preview:look": "tsx packages/engine/scripts/preview-look.ts",
    "smoke:higgsfield": "tsx packages/engine/scripts/smoke-higgsfield.ts",
    "sfx:generate": "tsx packages/engine/scripts/generate-sfx.ts",
    "build:face-helper": "swift build -c release --package-path tools/face-helper",
    "build:segment-helper": "swift build -c release --package-path tools/segment-helper",
    "smoke:elevenlabs": "tsx packages/engine/scripts/smoke-elevenlabs.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "worker:fake": "tsx apps/worker/src/main.ts --fake",
    "smoke:supabase": "tsx apps/worker/scripts/smoke-supabase.ts",
    "web": "npm run dev -w @reel/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
